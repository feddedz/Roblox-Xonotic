--[[
	Port of host.c @xonotic-v0.8.6. PARTIAL: the dedicated-server part of Host_Init that decides
	settings: cvar and command registration of every init function on the dedicated path (table
	engine/_port/sv_init_defs.luau, generated by tools/engine/gen_cvars.py), the value changes those init
	functions make for a dedicated server (Host_ServerOptions, FS_Rescan, COM_Init_Commands), then
	Cmd_SaveInitState, Host_AddConfigText and Cbuf_Execute (quake.rc chain).
	Engine commands that are not ported yet are registered as stubs that log `NOT YET PORTED: command <name>`
	when run, so command/alias/cvar lookup order is the same as in DarkPlaces.
	Each static `cvar_t` is available as host.cv.<C variable name> (e.g. host.cv.sv_gravity).
	Also: SV_ClientPrint(f), SV_BroadcastPrint(f), Host_ClientCommands, SV_DropClient, Host_TimingReport and one
	iteration of the Host_Main loop for a dedicated server (host.Host_Main_Frame(elapsed), see there for the parts
	left out).
	NOT YET PORTED: Host_Error, Host_Shutdown, Host_ShutdownServer, Memory_Init_Commands' reading of
	/proc/meminfo (sys_memsize_* keep their registered defaults: machine-dependent in DarkPlaces too),
	`-dedicated N` / other command-line options except -noconfig.
]]
local cmd = require("./cmd")
local collision = require("./collision")
local cvar = require("./cvar")
local defs = require("./_port/sv_init_defs")
local host_cmd = require("./host_cmd")
local model_brush = require("./model_brush") -- installs the brush loader hooks of model_shared
local model_shared = require("./model_shared")
local common = require("./common")
local console = require("./console")
local libc = require("./_port/libc")
local netconn = require("./netconn")
local prvm_cmds = require("./prvm_cmds")
local prvm_edict = require("./prvm_edict")
local server = require("./server")
local R = require("./_port/f32").round

local host = {}

host.cv = {} :: { [string]: cvar.Cvar }
host.svs = host_cmd.svs
local MAX_SCOREBOARD = 255 -- quakedef.h

local function stub(name: string): () -> ()
	return function()
		print("NOT YET PORTED: command " .. name)
	end
end

-- Host_Init (host.c L1162-1390), dedicated path, up to the first Cbuf_Execute after the config text.
-- opts.com_argv: command line (default { "xonotic-dedicated" }); opts.maxclients: like `-dedicated N`.
function host.Host_Init_Dedicated(opts: { com_argv: { string }?, maxclients: number? }?)
	cvar.reset()
	cmd.reset()
	host.cv = {}
	cmd.com_argv = (opts and opts.com_argv) or { "xonotic-dedicated" }
	cmd.gamemode = "GAME_XONOTIC"
	cvar.cls_state_dedicated = true
	cmd.Cmd_Init()
	local cmdInitDone = false
	for _, d in defs do
		if d[1] == "cvar" then
			local var, flags, name, dflt, desc = d[2], d[3], d[4], d[5], d[6]
			local c = cvar.static(flags, name, dflt, desc)
			host.cv[var] = c
			cvar.Cvar_RegisterVariable(c)
		else
			local name, desc, func = d[2], d[3], d[5]
			if func == "Cmd_Init_Commands" then
				if not cmdInitDone then
					cmdInitDone = true
					cmd.Cmd_Init_Commands() -- the ported commands of cmd.c, in their C order
				end
			elseif not cmd.Cmd_Exists(name) then
				cmd.Cmd_AddCommand(name, host_cmd.PORTED[name] or stub(name), desc)
			end
		end
	end
	-- the client functions of the Cmd_AddCommand_WithClientCommand commands (prespawn, spawn, begin, ...)
	host_cmd.Host_InitClientCommands()
	-- NetConn_Init (host.c Host_Init L1265): its cvars / commands are in the table above
	netconn.NetConn_Init()
	-- Collision_Init and Mod_Init -> Mod_BrushInit (host.c Host_Init): their cvars are in the table above; the
	-- calls bind the cvar_t records that the trace code reads as struct fields (collision.cv, model_brush.cv).
	collision.Collision_Init()
	-- Mod_Init (model_shared.c) resets the model registry and calls Mod_BrushInit (hook from model_brush.luau)
	assert(model_brush.Mod_IBSP_Load ~= nil, "model_brush installs the Mod_LoadModel hooks")
	model_shared.Mod_Init()
	-- COM_Init_Commands (common.c): Cvar_Set("cmdline", com_cmdline)
	if #cmd.com_argv > 1 then
		print("NOT YET PORTED: com_cmdline quoting for command-line arguments (common.c COM_Init_Commands)")
	end
	cvar.Cvar_Set("cmdline", "")
	-- FS_Rescan (fs.c L1440-1490): gamedir list, registered
	cvar.Cvar_SetQuick(host.cv.cvar_fs_gamedir, "data")
	-- (gfx/pop.lmp is not in Xonotic, so `registered` stays 0)
	-- Host_ServerOptions (host.c): no client in a dedicated server -> ca_dedicated
	local maxclients = (opts and opts.maxclients) or 8
	cvar.Cvar_SetValue("sv_public", 1)
	maxclients = math.clamp(maxclients, 1, MAX_SCOREBOARD)
	host.svs.maxclients, host.svs.maxclients_next = maxclients, maxclients
	if maxclients > 1 and host.cv.deathmatch.integer == 0 and host.cv.coop.integer == 0 then
		cvar.Cvar_SetValueQuick(host.cv.deathmatch, 1)
	end
	cmd.Cmd_SaveInitState()
	-- Host_AddConfigText (host.c L317-329), default branch
	cmd.Cbuf_InsertText(
		'alias startmap_sp "map start"\nalias startmap_dm "map start"\nexec ' .. cmd.STARTCONFIGFILENAME .. "\n"
	)
	cmd.Cbuf_Execute()
	if not cmd.host_stuffcmdsrun then
		cmd.Cbuf_AddText("exec default.cfg\nexec config.cfg\nexec autoexec.cfg\nstuffcmds\n")
		cmd.Cbuf_Execute()
	end
	-- (Host_Main then sets realtime = 0 and host_dirtytime = Sys_DirtyTime(): see host.Host_Main_Frame)
	host.realtime = 0
	host.host_dirtytime = 0
	host.cl_timer = 0
	host.sv_timer = 0
	prvm_edict.realtime = 0
	cmd.realtime = 0
end

--[[
===============================================================================

	Client messages, dropping a client and the server part of the frame loop (host.c L351-574, L654-1077).
	host_client is server.host_client (a client_t table of host_cmd.svs.clients, see engine/sv_main.luau).
	A client's netconnection is nil for a bot; the network parts run only with one (M6-NET).

===============================================================================
]]

local MAX_INPUTLINE = 16384 -- quakedef.h L128

-- sv_main / sv_phys require this module's users: required on first use and kept (a require() call resolves the
-- path every time in Lune, about 0.5 ms)
local lazymods: { [string]: any } = {}
local function SVMAIN(): any
	local m = lazymods.sv_main
	if not m then
		m = require("./sv_main")
		lazymods.sv_main = m
	end
	return m
end
local function SVPHYS(): any
	local m = lazymods.sv_phys
	if not m then
		m = require("./sv_phys")
		lazymods.sv_phys = m
	end
	return m
end

local warned: { [string]: boolean } = {}
local function notPorted(what: string)
	if not warned[what] then
		warned[what] = true
		print("NOT YET PORTED: " .. what)
	end
end

