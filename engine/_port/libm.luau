local libm = {}

local sb = buffer.create(8)
-- the 64-bit pattern of a double as two 32-bit halves (unsigned)
local function hiword(x: number): number
	buffer.writef64(sb, 0, x)
	return buffer.readu32(sb, 4)
end
local function loword(x: number): number
	buffer.writef64(sb, 0, x)
	return buffer.readu32(sb, 0)
end
-- the double with high word hi and low word lo (C: mynumber {{hi, lo}} in the BIG_ENDI tables)
local function w(hi: number, lo: number): number
	buffer.writeu32(sb, 4, hi)
	buffer.writeu32(sb, 0, lo)
	return buffer.readf64(sb, 0)
end
-- a table of 16-hex-digit bit patterns, whitespace separated
local function tab(s: string): { number }
	local t = {}
	for h in string.gmatch(s, "%x+") do
		table.insert(t, w(tonumber(string.sub(h, 1, 8), 16) :: number, tonumber(string.sub(h, 9, 16), 16) :: number))
	end
	return t
end
-- C copysign (x, y)
local function copysign(x: number, y: number): number
	if hiword(y) >= 0x80000000 then
		return -math.abs(x)
	end
	return math.abs(x)
end
-- x86-64's default NaN (what 0/0 and inf/inf give in the C build): sign bit set
local DEFAULT_NAN = w(0xfff80000, 0)

--[[ Exact fused multiply-add: round(a * b + c) with one rounding (C fma). The product is split exactly
	(Veltkamp / Dekker), the sum is done with Boldo and Melquiond's round-to-odd step ("Emulation of FMA and
	correctly rounded sums: proved algorithms using rounding to odd", IEEE TC 2008). Valid while a * b neither
	overflows nor underflows (|a|, |b| < 2^995, |a * b| > 2^-969), which holds for every call in this module;
	zero and non-finite operands are handled separately. ]]
local SPLIT = 134217729 -- 2^27 + 1
local function fma(a: number, b: number, c: number): number
	local ph = a * b
	if ph == 0 or c == 0 or ph - ph ~= 0 or c - c ~= 0 then
		return ph + c -- exact product (zero) or non-finite operand: a * b + c already is the fused result
	end
	local p = a * SPLIT
	local ah = p - (p - a)
	local al = a - ah
	p = b * SPLIT
	local bh = p - (p - b)
	local bl = b - bh
	local pl = ((ah * bh - ph) + ah * bl + al * bh) + al * bl -- a * b == ph + pl exactly
	local uh = c + ph -- c + ph == uh + ul exactly
	local bv = uh - c
	local ul = (c - (uh - bv)) + (ph - bv)
	local s = ul + pl -- round to odd: s, or its neighbour toward the rounding error when s is even
	local sv = s - ul
	local e = (ul - (s - sv)) + (pl - sv)
	if e ~= 0 then
		buffer.writef64(sb, 0, s)
		local lo = buffer.readu32(sb, 0)
		if lo % 2 == 0 then
			local hi = buffer.readu32(sb, 4)
			if (s > 0) == (e > 0) then
				lo += 1 -- away from zero (lo is even, no carry)
			elseif lo == 0 then
				lo = 0xffffffff
				hi -= 1
			else
				lo -= 1
			end
			s = w(hi, lo)
		end
	end
	return uh + s
end
-- the FMA build's fused forms: mla (a, b, c) = a * b + c, mls (a, b, c) = c - a * b
local function mla(a: number, b: number, c: number): number
	return fma(a, b, c)
end
local function mls(a: number, b: number, c: number): number
	return fma(-a, b, c)
end

