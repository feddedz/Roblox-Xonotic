	if x <= 0 then
		dx = -dx
	end
	local ax = math.abs(x)
	local u = big + ax
	x = ax - (u - big)
	local xx = x * x
	local s = x + mla(x * xx, mla(xx, sn5, sn3), dx)
	local c = mla(x, dx, xx * mla(xx, mla(xx, cs6, cs4), cs2))
