local TWO32 = 4294967296
-- C (int32_t) x >> n for a uint32 bit pattern x
local function sar(x: number, n: number): number
	local v = bit32.arshift(x, n)
	return if v >= 0x80000000 then v - TWO32 else v
end
local INF = math.huge
local LN2HI, LN2LO = EXP_K[5], EXP_K[6]

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_log.c __log
function libm.log(x: number): number
	local ixh, ixl = hiword(x), loword(x)
	if ixh >= 0x3fee0000 and ixh < 0x3ff10900 then
		-- close to 1.0: ix - LO < HI - LO, LO = asuint64 (1.0 - 0x1p-4), HI = asuint64 (1.0 + 0x1.09p-4)
		if ixh == 0x3ff00000 and ixl == 0 then
			return 0
		end
		local B = LOG_B -- B[0] .. B[10] of the C are B[1] .. B[11]
		local r = x - 1.0
		local r2 = r * r
		local r3 = r * r2
		local c = mla(r3, B[11], mla(r2, B[10], mla(r, B[9], B[8])))
		local d = mla(r3, c, mla(r2, B[7], mla(r, B[6], B[5])))
		local e = mla(r3, d, mla(r2, B[4], mla(r, B[3], B[2])))
		local wv = r * 134217728 -- 0x1p27
		local rhi = r + wv - wv
		local rlo = r - rhi
		local rr = rhi * rhi -- w = rhi * rhi * B[0], fused into hi and lo
		local hi = mla(rr, B[1], r)
		local lo = mla(rr, B[1], r - hi)
		lo = mla(B[1] * rlo, rhi + r, lo)
		local y = mla(r3, e, lo) -- y = r3 * (...); y += lo
		return y + hi
	end
	local top = bit32.rshift(ixh, 16)
	if top < 0x0010 or top >= 0x7ff0 then
		-- x < 0x1p-1022 or inf or nan
		if bit32.band(ixh, 0x7fffffff) == 0 and ixl == 0 then
			return -INF -- __math_divzero (1)
		elseif ixh == 0x7ff00000 and ixl == 0 then
			return x
		elseif bit32.band(top, 0x8000) ~= 0 or bit32.band(top, 0x7ff0) == 0x7ff0 then
			return nanof(x) -- __math_invalid: (x - x) / (x - x)
		end
		-- x is subnormal, normalize it
		local xs = x * 4503599627370496 -- 0x1p52
		ixh, ixl = hiword(xs) - 52 * 0x100000, loword(xs)
	end
	local tmph = (ixh - 0x3fe60000) % TWO32 -- tmp = ix - OFF, OFF = 0x3fe6000000000000
	local i = bit32.band(bit32.rshift(tmph, 13), 127)
	local k = sar(tmph, 20)
	local z = w((ixh - bit32.band(tmph, 0xfff00000)) % TWO32, ixl)
	local invc, logc = LOG_TAB[2 * i + 1], LOG_TAB[2 * i + 2]
	local r = fma(z, invc, -1.0)
	local kd = k
	local wv = mla(kd, LN2HI, logc)
	local hi = wv + r
	local lo = mla(kd, LN2LO, (wv - hi) + r)
	local A = LOG_A
	local r2 = r * r
	local p = mla(r2, mla(r, A[5], A[4]), mla(r, A[3], A[2]))
	return mla(r * r2, p, mla(r2, A[1], lo)) + hi
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_pow.c log_inline; ix as halves; returns y, tail
local function pow_log_inline(ixh: number, ixl: number): (number, number)
	local tmph = (ixh - 0x3fe69555) % TWO32 -- OFF = 0x3fe6955500000000
	local i = bit32.band(bit32.rshift(tmph, 13), 127)
	local k = sar(tmph, 20)
	local z = w((ixh - bit32.band(tmph, 0xfff00000)) % TWO32, ixl)
	local kd = k
	local b = 3 * i
	local invc, logc, logctail = POW_TAB[b + 1], POW_TAB[b + 2], POW_TAB[b + 3]
	local r = fma(z, invc, -1.0)
	local t1 = mla(kd, LN2HI, logc)
	local t2 = t1 + r
	local lo1 = mla(kd, LN2LO, logctail)
	local lo2 = t1 - t2 + r
	local A = POW_A
	local ar = A[1] * r
	local ar2 = r * ar
	local ar3 = r * ar2
	local hi = t2 + ar2
	local lo3 = fma(ar, r, -ar2)
	local lo4 = t2 - hi + ar2
	local q = mla(ar2, mla(ar2, mla(r, A[7], A[6]), mla(r, A[5], A[4])), mla(r, A[3], A[2]))
	local lo = mla(ar3, q, lo1 + lo2 + lo3 + lo4) -- p = ar3 * (...) fused into lo
	local y = hi + lo
	return y, hi - y + lo
end

local P2_1009 = w(0x7f000000, 0)
local P2_M1022 = w(0x00100000, 0)
local SIGN_BIAS = 0x40000 -- 0x800 << EXP_TABLE_BITS

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_pow.c specialcase
local function pow_specialcase(tmp: number, sh: number, sl: number, kil: number): number
	if bit32.band(kil, 0x80000000) == 0 then
		-- k > 0, the exponent of scale might have overflowed by <= 460
		local scale = w((sh - 1009 * 0x100000) % TWO32, sl)
		local y = mla(scale, tmp, scale)
		return y * P2_1009
	end
	-- k < 0, need special care in the subnormal range
	sh = (sh + 1022 * 0x100000) % TWO32
	local scale = w(sh, sl)
	local y = mla(scale, tmp, scale)
	if math.abs(y) < 1.0 then
		local one = if y < 0.0 then -1.0 else 1.0
		local lo = mla(scale, tmp, scale - y)
		local hi = one + y
		lo = one - hi + y + lo
		y = (hi + lo) - one
		if y == 0.0 then
			y = w(bit32.band(sh, 0x80000000), 0) -- fix the sign of 0
		end
	end
	return P2_M1022 * y
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_pow.c exp_inline: sign * exp (x + xtail)
local function pow_exp_inline(x: number, xtail: number, sign_bias: number): number
	local abstop = bit32.band(bit32.rshift(hiword(x), 20), 0x7ff)
	if (abstop - 0x3c9) % TWO32 >= 0x408 - 0x3c9 then -- top12 (0x1p-54), top12 (512.0)
		if abstop < 0x3c9 then
			local one = 1.0 + x
			return if sign_bias ~= 0 then -one else one
		end
		if abstop >= 0x409 then -- top12 (1024.0)
			local s = if sign_bias ~= 0 then -1 else 1
			if hiword(x) >= 0x80000000 then
				return s * 0.0 -- __math_uflow
			end
			return s * INF -- __math_oflow
		end
		abstop = 0 -- large x is special cased below
	end
	local kd = mla(EXP_K[1], x, EXP_K[4]) -- z = InvLn2N * x; kd = z + Shift
	local kil = loword(kd) -- ki = asuint64 (kd), low half
	kd -= EXP_K[4]
	local r = mla(kd, EXP_K[3], mla(kd, EXP_K[2], x)) + xtail
	local idx = 2 * (kil % 128)
	local toph = bit32.lshift(bit32.band((kil + sign_bias) % TWO32, 0x7ffff), 13) -- (ki + sign_bias) << 45
	local tail = EXP_TAB[idx + 1]
	local hv = EXP_TAB[idx + 2]
	local sh, sl = (hiword(hv) + toph) % TWO32, loword(hv)
	local r2 = r * r
	local C = EXP_C
	local tmp = mla(r2 * r2, mla(r, C[4], C[3]), mla(r2, mla(r, C[2], C[1]), tail + r))
	if abstop == 0 then
		return pow_specialcase(tmp, sh, sl, kil)
	end
	local scale = w(sh, sl)
	return mla(scale, tmp, scale)
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_pow.c checkint: 0 not an integer, 1 odd, 2 even (iy non-zero finite)
local function checkint(iyh: number, iyl: number): number
	local e = bit32.band(bit32.rshift(iyh, 20), 0x7ff)
	if e < 0x3ff then
		return 0
	elseif e > 0x3ff + 52 then
		return 2
	end
	local s = 0x3ff + 52 - e -- 0 .. 52
	local lowzero
	if s == 0 then
		lowzero = true
	elseif s <= 32 then
		lowzero = bit32.extract(iyl, 0, s) == 0
	else
		lowzero = iyl == 0 and bit32.extract(iyh, 0, s - 32) == 0
	end
	if not lowzero then
		return 0
	end
	local bit = if s < 32 then bit32.extract(iyl, s, 1) else bit32.extract(iyh, s - 32, 1)
	return if bit == 1 then 1 else 2
end

-- a signaling NaN (glibc's issignaling_inline; x86: quiet bit clear)
local function issignaling(h: number, l: number): boolean
	return bit32.band(h, 0x7ff80000) == 0x7ff00000 and (bit32.band(h, 0x0007ffff) ~= 0 or l ~= 0)
end
-- x + y for a NaN operand on x86-64: the first NaN operand, quieted
local function nanadd(x: number, xh: number, xl: number, y: number): number
	if x ~= x then
		return w(bit32.bor(xh, 0x00080000), xl)
	end
	buffer.writef64(sb, 0, y)
	return w(bit32.bor(buffer.readu32(sb, 4), 0x00080000), buffer.readu32(sb, 0))
end
-- 2 * i (sign dropped) compared as 64-bit numbers: the magnitude bits
local function mag(h: number): number
	return bit32.band(h, 0x7fffffff)
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_pow.c __pow
function libm.pow(x: number, y: number): number
	local sign_bias = 0
	local ixh, ixl = hiword(x), loword(x)
	local iyh, iyl = hiword(y), loword(y)
	local topx = bit32.rshift(ixh, 20)
	local topy = bit32.rshift(iyh, 20)
	local ey = bit32.band(topy, 0x7ff)
	if topx == 0 or topx >= 0x7ff or ey < 0x3be or ey >= 0x43e then
		-- special cases: (x < 0x1p-126 or inf or nan) or (|y| < 0x1p-65 or |y| >= 0x1p63 or nan)
		local my, mx = mag(iyh), mag(ixh)
		if (my == 0 and iyl == 0) or my >= 0x7ff00000 then -- zeroinfnan (iy)
			if my == 0 and iyl == 0 then
				return if issignaling(ixh, ixl) then nanadd(x, ixh, ixl, y) else 1.0
			end
			if ixh == 0x3ff00000 and ixl == 0 then
				return if issignaling(iyh, iyl) then nanadd(x, ixh, ixl, y) else 1.0
			end
			if
				(mx > 0x7ff00000 or (mx == 0x7ff00000 and ixl ~= 0))
				or (my > 0x7ff00000 or (my == 0x7ff00000 and iyl ~= 0))
			then
				return nanadd(x, ixh, ixl, y)
			end
			if mx == 0x3ff00000 and ixl == 0 then
				return 1.0
			end
			local xlt1 = mx < 0x3ff00000
			if xlt1 == (iyh < 0x80000000) then
				return 0.0 -- |x|<1 && y==inf or |x|>1 && y==-inf
			end
			return y * y
		end
		if (mx == 0 and ixl == 0) or mx >= 0x7ff00000 then -- zeroinfnan (ix)
			local x2 = x * x
			if ixh >= 0x80000000 and checkint(iyh, iyl) == 1 then
				x2 = -x2
				sign_bias = 1
			end
			if mx == 0 and ixl == 0 and iyh >= 0x80000000 then
				return (if sign_bias ~= 0 then -1.0 else 1.0) / 0.0 -- __math_divzero
			end
			return if iyh >= 0x80000000 then 1 / x2 else x2
		end
		-- here x and y are non-zero finite
		if ixh >= 0x80000000 then
			-- finite x < 0
			local yint = checkint(iyh, iyl)
			if yint == 0 then
				return DEFAULT_NAN -- __math_invalid (x)
			elseif yint == 1 then
				sign_bias = SIGN_BIAS
			end
			ixh = mx
			topx = bit32.band(topx, 0x7ff)
		end
		if ey < 0x3be or ey >= 0x43e then
			-- note: sign_bias == 0 here because y is not odd
			if ixh == 0x3ff00000 and ixl == 0 then
				return 1.0
			end
			local xgt1 = ixh > 0x3ff00000 or (ixh == 0x3ff00000 and ixl > 0)
			if ey < 0x3be then
				-- |y| < 2^-65, x^y ~= 1 + y*log(x)
				return if xgt1 then 1.0 + y else 1.0 - y
			end
			return if xgt1 == (topy < 0x800) then INF else 0.0 -- __math_oflow (0) : __math_uflow (0)
		end
		if topx == 0 then
			-- normalize subnormal x so exponent becomes negative
			local xs = x * 4503599627370496
			ixh, ixl = mag(hiword(xs)) - 52 * 0x100000, loword(xs)
		end
	end
	local hi, lo = pow_log_inline(ixh, ixl)
	local ehi = y * hi
	local elo = mla(y, lo, fma(y, hi, -ehi))
	return pow_exp_inline(ehi, elo, sign_bias)
end

-- C fmod (x, y): exact in IEEE arithmetic, so the host's math.fmod gives the same bits, except for the NaN of
-- the invalid cases (x infinite or y zero), which glibc computes on x86-64 as the default NaN
function libm.fmod(x: number, y: number): number
	if x == x and y == y and (x - x ~= 0 or y == 0) then
		return DEFAULT_NAN
	end
	return math.fmod(x, y)
end

return libm
