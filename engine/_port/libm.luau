		if x > 0 then
			return copysign(ay / ax, y)
		end
		return if y > 0 then a2_opi else a2_mopi
	end
	-- if either x or y is extremely close to zero, scale abs(x), abs(y); likewise for large x and y
	if ax < a2_twom500 or ay < a2_twom500 then
		ax *= a2_two500
		ay *= a2_two500
	end
	if ax > a2_two500 or ay > a2_two500 then
		ax *= a2_twom500
		ay *= a2_twom500
	end
	-- x, y which are neither special nor extreme
	local u, du
	if ay < ax then
		u = ay / ax
		local v = ax * u -- EMULV with DLA_FMS: v + vv == ax * u exactly
		local vv = fma(ax, u, -v)
		du = ((ay - v) - vv) / ax
	else
		u = ax / ay
		local v = ay * u
		local vv = fma(ay, u, -v)
		du = ((ax - v) - vv) / ay
	end
	local z
	if x > 0 then
		if ay < ax then
			-- (i) x>0, abs(y)< abs(x): atan(ay/ax)
			if u < a2_inv16 then
				local v = u * u
				local zz = mla(u * v, atan2_poly(v), du)
				z = u + zz
			else
				local i = cij_index(u)
				local b = i * 7
				local t3 = u - CIJ[b + 1]
				local v, dv = eadd(t3, du)
				local t1, t2 = CIJ[b + 2], CIJ[b + 3]
				local zz = mla(
					v,
					t2,
					mla(dv, t2, v * v * mla(v, mla(v, mla(v, CIJ[b + 7], CIJ[b + 6]), CIJ[b + 5]), CIJ[b + 4]))
				)
				z = t1 + zz
			end
		elseif u < a2_inv16 then
			-- (ii) x>0, abs(x)<=abs(y): pi/2-atan(ax/ay)
			local v = u * u
			local t2, cor = esub(a2_hpi, u)
			local t3 = mls(u * v, atan2_poly(v), (a2_hpi1 + cor) - du)
			z = t2 + t3
		else
			local i = cij_index(u)
			local b = i * 7
			local v = (u - CIJ[b + 1]) + du
			local zz = mls(v, cij_poly(i, v), a2_hpi1)
			local t1 = a2_hpi - CIJ[b + 2]
			z = t1 + zz
		end
	elseif ax < ay then
		-- (iii) x<0, abs(x)< abs(y): pi/2+atan(ax/ay)
		if u < a2_inv16 then
			local v = u * u
			local t2, cor = eadd(a2_hpi, u)
			local t3 = mla(u * v, atan2_poly(v), (a2_hpi1 + cor) + du)
			z = t2 + t3
		else
			local i = cij_index(u)
			local b = i * 7
			local v = (u - CIJ[b + 1]) + du
			local zz = mla(v, cij_poly(i, v), a2_hpi1)
			local t1 = a2_hpi + CIJ[b + 2]
			z = t1 + zz
		end
	elseif u < a2_inv16 then
		-- (iv) x<0, abs(y)<=abs(x): pi-atan(ax/ay)
		local v = u * u
		local t2, cor = esub(a2_opi, u)
		local t3 = mls(u * v, atan2_poly(v), (a2_opi1 + cor) - du)
		z = t2 + t3
	else
		local i = cij_index(u)
		local b = i * 7
		local v = (u - CIJ[b + 1]) + du
		local zz = mls(v, cij_poly(i, v), a2_opi1)
		local t1 = a2_opi - CIJ[b + 2]
		z = t1 + zz
	end
	return copysign(z, y) -- signArctan2
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/atnat.h (constants; d3 .. d13 equal those of atnat2.h)
local at_A = w(0x3e4bb67a, 0)
local at_B = w(0x3fb00000, 0)
local at_C = w(0x3ff00000, 0)
local at_D = w(0x40300000, 0)
local at_E = w(0x43349ff2, 0)
local at_HPI = w(0x3ff921fb, 0x54442d18)
local at_MHPI = w(0xbff921fb, 0x54442d18)
local at_HPI1 = w(0x3c91a626, 0x33145c07)

-- cij[i][5] + z * cij[i][6], then cij[i][4] + z * yy, ... down to cij[i][2] (s_atan.c), fused
local function atan_cij(b: number, z: number): number
	return mla(z, mla(z, mla(z, mla(z, CIJ[b + 7], CIJ[b + 6]), CIJ[b + 5]), CIJ[b + 4]), CIJ[b + 3])
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/s_atan.c __atan
function libm.atan(x: number): number
	local ux, dx = hiword(x), loword(x)
	if bit32.band(ux, 0x7ff00000) == 0x7ff00000 and bit32.bor(bit32.band(ux, 0x000fffff), dx) ~= 0 then
		return x -- x + x: x is NaN
	end
	local u = if x < 0 then -x else x
	if u < at_C then
		if u < at_B then
			if u < at_A then
				return x
			end
			-- A <= u < B
			local v = x * x
			return mla(atan2_poly(v), x * v, x)
		end
		-- B <= u < C
		local i = cij_index(u)
		local b = i * 7
		local z = u - CIJ[b + 1]
		local y = mla(atan_cij(b, z), z, CIJ[b + 2])
		return copysign(y, x)
	elseif u < at_D then
		-- C <= u < D
		local wv = 1 / u
		local t1 = wv * u -- EMULV (w, u, t1, t2)
		local t2 = fma(wv, u, -t1)
		local i = cij_index(wv)
		local b = i * 7
		local z = mla(wv, (1 - t1) - t2, wv - CIJ[b + 1]) -- (w - cij[i][0]) + ww, ww = w * ((1 - t1) - t2)
		local yy = mls(z, atan_cij(b, z), at_HPI1)
		local y = (at_HPI - CIJ[b + 2]) + yy
		return copysign(y, x)
	elseif u < at_E then
		-- D <= u < E
		local wv = 1 / u
		local v = wv * wv
		local t1 = wv * u
		local t2 = fma(wv, u, -t1)
		local yy = atan2_poly(v) -- then yy *= w * v, fused below
		local t3, cor = esub(at_HPI, wv)
		local r = mls(yy, wv * v, mls(wv, (1 - t1) - t2, at_HPI1 + cor)) -- ((HPI1 + cor) - ww) - yy
		return copysign(t3 + r, x)
	end
	return if x > 0 then at_HPI else at_MHPI
end

