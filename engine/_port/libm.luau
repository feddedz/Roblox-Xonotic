-- port: glibc-2.43 sysdeps/ieee754/dbl-64/uasncs.h (constants; decimal literals as the C compiler rounds them)
local as_hp0 = w(0x3ff921fb, 0x54442d18)
local as_hp1 = w(0x3c91a626, 0x33145c07)
local as_f1 = w(0x3fc55555, 0x555554f9)
local as_f2 = w(0x3fb33333, 0x3336127d)
local as_f3 = w(0x3fa6db6d, 0xae42c0e4)
local as_f4 = w(0x3f9f1c7e, 0x04f4ad99)
local as_f5 = w(0x3f96e442, 0xc822d419)
local as_f6 = w(0x3f9292d8, 0x0f453c72)
local as_t24 = 16777216.0
local as_t27 = 134217728.0
local as_rt0 = w(0x3fefffff, 0xffecc1dd)
local as_rt1 = w(0x3fdfffff, 0xff757304)
local as_rt2 = w(0x3fd80049, 0x6769c91a)
local as_rt3 = w(0x3fd40063, 0x18d1dab9)
-- port: glibc-2.43 sysdeps/ieee754/dbl-64/powtwo.tbl powtwo (2^0 .. 2^27)
local POWTWO = table.create(28, 1)
for i = 2, 28 do
	POWTWO[i] = POWTWO[i - 1] * 2
end

-- (((((f6 * z + f5) * z + f4) * z + f3) * z + f2) * z + f1), fused
local function asin_fpoly(z: number): number
	return mla(mla(mla(mla(mla(as_f6, z, as_f5), z, as_f4), z, as_f3), z, as_f2), z, as_f1)
end

-- the table ranges 0.125 <= |x| < 0.96875 of e_asin.c: (n, polynomial degree, index of the constant term)
local function asncs_range(k: number): (number, number)
	if k < 0x3fe00000 then
		if k < 0x3fd00000 then
			return 11 * bit32.rshift(bit32.band(k, 0x000fffff), 15), 5
		end
		return 11 * bit32.rshift(bit32.band(k, 0x000fffff), 14) + 352, 5
	elseif k < 0x3fe80000 then
		return 1056 + bit32.rshift(bit32.band(k, 0x000fe000), 11) * 3, 6
	elseif k < 0x3fed8000 then
		return 992 + bit32.rshift(bit32.band(k, 0x000fe000), 13) * 13, 7
	elseif k < 0x3fee8000 then
		return 884 + bit32.rshift(bit32.band(k, 0x000fe000), 13) * 14, 8
	end
	return 768 + bit32.rshift(bit32.band(k, 0x000fe000), 13) * 15, 9
end

-- t = asncs[n+1]*xx; p = xx*xx*(asncs[n+2] + xx*(... asncs[n+d+1])) + asncs[n+d+2]; t += p (fused);
-- returns t and the index of the result term asncs[n+d+3]
local function asncs_eval(n: number, d: number, xx: number): (number, number)
	local q = ASNCS[n + d + 2] -- the highest coefficient asncs[n+d+1]
	for j = d, 2, -1 do
		q = mla(xx, q, ASNCS[n + j + 1])
	end
	local p = mla(xx * xx, q, ASNCS[n + d + 3])
	return mla(ASNCS[n + 2], xx, p), n + d + 4
end

-- 1 / sqrt (z) start value and Newton steps of e_asin.c for 0.96875 <= |x| < 1; returns c, t
local function asin_root(z: number): (number, number)
	local k = hiword(z)
	local t = INROOT[bit32.rshift(bit32.band(k, 0x001fffff), 14) + 1] * POWTWO[511 - bit32.arshift(k, 21) + 1]
	local r = mls(t * t, z, 1.0)
	t = t * mla(r, mla(r, mla(r, as_rt3, as_rt2), as_rt1), as_rt0)
	local c = t * z
	return c, mls(0.5 * t, c, 1.5) -- t = c * (this), fused into the uses (t + y)
end

-- |x| > 1 or NaN. On x86-64 the program's asin / acos symbol is glibc's SVID compat wrapper
-- (math/w_asin_compat.c, w_acos_compat.c): for |x| > 1 it returns __kernel_standard's NAN (a positive quiet
-- NaN); a NaN argument goes through __ieee754_asin's (x - x) / (x - x) and stays itself.
local POSITIVE_NAN = w(0x7ff80000, 0)
local function asin_domain(x: number): number
	if x ~= x then
		return x
	end
	return POSITIVE_NAN
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_asin.c __ieee754_asin
function libm.asin(x: number): number
	local m = hiword(x)
	local k = bit32.band(m, 0x7fffffff)
	local pos = m < 0x80000000 -- m > 0 (x == +0 returned below)
	if k < 0x3e500000 then
		return x
	elseif k < 0x3fc00000 then
		-- 2^-26 <= |x| < 2^-3
		local x2 = x * x
		return mla(asin_fpoly(x2), x2 * x, x)
	elseif k < 0x3fef0000 then
		-- 0.125 <= |x| < 0.96875
		local n, d = asncs_range(k)
		local xx = (if pos then x else -x) - ASNCS[n + 1]
		local t, r = asncs_eval(n, d, xx)
		local res = ASNCS[r] + t
		return if pos then res else -res
	elseif k < 0x3ff00000 then
		-- 0.96875 <= |x| < 1
		local z = 0.5 * (if pos then (1.0 - x) else (1.0 + x))
		local c, tf = asin_root(z)
		local y = (c + as_t24) - as_t24
		local cc = mls(y, y, z) / mla(c, tf, y)
		local p = asin_fpoly(z) * z
		local cor = mls(2.0 * (y + cc), p, mls(2.0, cc, as_hp1))
		local res1 = mls(2.0, y, as_hp0)
		local res = res1 + cor
		return if pos then res else -res
	elseif k == 0x3ff00000 and loword(x) == 0 then
		return if pos then as_hp0 else -as_hp0
	end
	return asin_domain(x)
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/e_asin.c __ieee754_acos
function libm.acos(x: number): number
	local m = hiword(x)
	local k = bit32.band(m, 0x7fffffff)
	local pos = m < 0x80000000 and m ~= 0 -- m > 0
	if k < 0x3c880000 then
		return as_hp0
	elseif k < 0x3fc00000 then
		-- 2.77556*10^-17 <= |x| < 2^-3
		local x2 = x * x
		local r = as_hp0 - x
		local cor = mls(asin_fpoly(x2), x2 * x, ((as_hp0 - r) - x) + as_hp1)
		return r + cor
	elseif k < 0x3fef0000 then
		-- 0.125 <= |x| < 0.96875
		local n, d = asncs_range(k)
		local xx = (if pos then x else -x) - ASNCS[n + 1]
		local t, r = asncs_eval(n, d, xx)
		local y = if pos then (as_hp0 - ASNCS[r]) else (as_hp0 + ASNCS[r])
		t = if pos then (as_hp1 - t) else (as_hp1 + t)
		return y + t
	elseif k < 0x3ff00000 then
		-- 0.96875 <= |x| < 1
		local z = 0.5 * (if pos then (1.0 - x) else (1.0 + x))
		local c, tf = asin_root(z)
		local y = mls(as_t27, c, mla(as_t27, c, c)) -- (t27*c + c) - t27*c, both products fused
		local cc = mls(y, y, z) / mla(c, tf, y)
		local p = asin_fpoly(z) * z
		if not pos then
			local cor = mls(y + cc, p, as_hp1 - cc)
			local res = (as_hp0 - y) + cor
			return res + res
		end
		local res = y + mla(p, y + cc, cc)
		return res + res
	elseif k == 0x3ff00000 and loword(x) == 0 then
		return if pos then 0 else 2.0 * as_hp0
	end
	return asin_domain(x)
end

