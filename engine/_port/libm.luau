	local sn, ssn, cs, ccs = SINCOSTAB[k + 1], SINCOSTAB[k + 2], SINCOSTAB[k + 3], SINCOSTAB[k + 4]
	local cor = mla(cs, s, mls(sn, c, mla(s, ccs, ssn)))
