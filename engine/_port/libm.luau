-- Dekker's exact sum and difference (dla.h EADD / ESUB): z + zz == x + y (x - y) exactly
local function eadd(x: number, y: number): (number, number)
	local z = x + y
	return z, if math.abs(x) > math.abs(y) then ((x - z) + y) else ((y - z) + x)
end
local function esub(x: number, y: number): (number, number)
	local z = x - y
	return z, if math.abs(x) > math.abs(y) then ((x - z) - y) else (x - (y + z))
end
