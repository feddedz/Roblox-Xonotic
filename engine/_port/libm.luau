-- port: glibc-2.43 sysdeps/ieee754/dbl-64/utan.h (constants)
local tn_d3 = w(0x3fd55555, 0x55555555)
local tn_d5 = w(0x3fc11111, 0x111107c6)
local tn_d7 = w(0x3faba1ba, 0x1cdb8745)
local tn_d9 = w(0x3f9664ed, 0x49cfc666)
local tn_d11 = w(0x3f82385a, 0x3cf2e4ea)
local tn_e0 = w(0x3fd55555, 0x55554dbd)
local tn_e1 = w(0x3fc11112, 0xe0a6b45f)
local tn_mfftnhf = w(0xc02f0000, 0)
local tn_g1 = w(0x3e4b096c, 0)
local tn_g2 = w(0x3faf212d, 0)
local tn_g3 = w(0x3fe92f1a, 0)
local tn_g4 = w(0x40390000, 0)
local tn_g5 = w(0x4197d784, 0)
local tn_gy2 = w(0x3faf212d, 0)
local tn_mp1 = w(0x3ff921fb, 0x58000000)
local tn_mp2 = w(0xbe4dde97, 0x3c000000)
local tn_mp3 = w(0xbc8cb3b3, 0x99d747f2)
local tn_pp3 = w(0xbc8cb3b3, 0x98000000)
local tn_pp4 = w(0xbacd747f, 0x23e32ed7)
local tn_hpinv = w(0x3fe45f30, 0x6dc9c883)
local tn_toint = w(0x43380000, 0)

-- d3 + x2 * (d5 + x2 * (d7 + x2 * (d9 + x2 * d11))) of s_tan.c, fused
local function tan_poly(x2: number): number
	return mla(x2, mla(x2, mla(x2, mla(x2, tn_d11, tn_d9), tn_d7), tn_d5), tn_d3)
end

-- the cases 0 < abs(y) <= 0.0608 and 0.0608 < abs(y) <= 0.787 after a range reduction (VI .. XI of s_tan.c)
local function tan_reduced(a: number, da: number, n: number): number
	local ya, yya, sy
	if a < 0.0 then
		ya, yya, sy = -a, -da, -1
	else
		ya, yya, sy = a, da, 1
	end
	if ya <= tn_gy2 then
		local a2 = a * a
		local t2 = mla(a * a2, tan_poly(a2), da)
		if n ~= 0 then
			-- -cot: EADD (a, t2, b, db); DIV2 (1.0, 0.0, b, db, c, dc, ...)
			local b, db = eadd(a, t2)
			local c = 1.0 / b
			local u = c * b -- MUL12 = EMULV with DLA_FMS
			local uu = fma(c, b, -u)
			local cc = mls(c, db, ((1.0 - u) - uu) + 0.0) / b
			local z = c + cc
			local zz = (c - z) + cc
			return -(z + zz)
		end
		return a + t2
	end
	local i = math.floor(tn_mfftnhf + 256 * ya)
	local b = i * 4
	local z = (ya - XFG[b + 1]) + yya
	local z2 = z * z
	local pz = mla(z * z2, mla(z2, tn_e1, tn_e0), z)
	local fi, gi = XFG[b + 2], XFG[b + 3]
	if n ~= 0 then
		local t2 = pz * (fi + gi) / (fi + pz)
		return -sy * (gi - t2)
	end
	local t2 = pz * (gi + fi) / (gi - pz)
	return sy * (fi + t2)
end

-- port: glibc-2.43 sysdeps/ieee754/dbl-64/s_tan.c __tan
function libm.tan(x: number): number
	local ux = hiword(x)
	if bit32.band(ux, 0x7ff00000) == 0x7ff00000 then
		return nanof(x) -- x - x
	end
	local wa = if x < 0.0 then -x else x
	if wa <= tn_g1 then
		-- (I) abs(x) <= 1.259e-8
		return x
	elseif wa <= tn_g2 then
		-- (II) 1.259e-8 < abs(x) <= 0.0608
		local x2 = x * x
		return mla(tan_poly(x2), x * x2, x)
	elseif wa <= tn_g3 then
		-- (III) 0.0608 < abs(x) <= 0.787
		local i = math.floor(tn_mfftnhf + 256 * wa)
		local b = i * 4
		local z = wa - XFG[b + 1]
		local z2 = z * z
		local s = if x < 0.0 then -1 else 1
		local pz = mla(z * z2, mla(z2, tn_e1, tn_e0), z)
		local fi, gi = XFG[b + 2], XFG[b + 3]
		local t2 = pz * (gi + fi) / (gi - pz)
		return s * (fi + t2)
	elseif wa <= tn_g4 then
		-- 0.787 < abs(x) <= 25: range reduction by algorithm i
		local t = mla(x, tn_hpinv, tn_toint)
		local xn = t - tn_toint
		local t1 = mls(xn, tn_mp2, mls(xn, tn_mp1, x))
		local n = bit32.band(loword(t), 1)
		local a = mls(xn, tn_mp3, t1)
		local da = mls(xn, tn_mp3, t1 - a)
		return tan_reduced(a, da, n)
	elseif wa <= tn_g5 then
		-- 25 < abs(x) <= 1e8: range reduction by algorithm ii
		local t = mla(x, tn_hpinv, tn_toint)
		local xn = t - tn_toint
		local t1 = mls(xn, tn_mp2, mls(xn, tn_mp1, x))
		local n = bit32.band(loword(t), 1)
		t = mls(xn, tn_pp3, t1)
		local da = mls(xn, tn_pp3, t1 - t)
		local a = mls(xn, tn_pp4, t)
		da = mls(xn, tn_pp4, t - a) + da
		a, da = eadd(a, da)
		return tan_reduced(a, da, n)
	end
	-- 1e8 < abs(x) < 2**1024: range reduction by algorithm iii
	local n, a, da = branred(x)
	a, da = eadd(a, da)
	return tan_reduced(a, da, bit32.band(n, 1))
end

