	local xn = t - toint
	local y = mls(xn, mp2, mls(xn, mp1, x))
	local n = bit32.band(loword(t), 3)
	local t2 = mls(xn, pp3, y)
	local db = mls(xn, pp3, y - t2)
	local b = mls(xn, pp4, t2)
	db += mls(xn, pp4, t2 - b)
	return n, b, db
